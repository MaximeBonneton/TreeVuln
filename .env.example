# PostgreSQL (superuser — used only for schema management)
POSTGRES_USER=treevuln
POSTGRES_PASSWORD=
POSTGRES_DB=treevuln
# IMPORTANT: Generate a strong password:
#   python -c "import secrets; print(secrets.token_urlsafe(24))"

# Application role (least-privilege, used by the backend)
# If APP_DB_PASSWORD is empty, the backend uses the superuser (not recommended)
APP_DB_USER=treevuln_app
APP_DB_PASSWORD=
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(24))"

# Backend
# If APP_DB_PASSWORD is set, use the URL with the application role:
# DATABASE_URL=postgresql+asyncpg://${APP_DB_USER}:${APP_DB_PASSWORD}@db:5432/${POSTGRES_DB}
# Otherwise, use the superuser (dev only):
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}
DEBUG=false

# Encryption key for API keys, webhook secrets, etc.
# IMPORTANT: Generate and set this for production:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# If empty, an auto-generated key is stored in the database, NEXT TO the
# data it encrypts (a DB dump exposes all secrets). Acceptable for
# development only — with DEBUG=false the backend logs an ERROR at startup.
SECRET_KEY=

# CORS (comma-separated origins)
ALLOWED_ORIGINS=https://localhost:3000

# Enterprise license (leave empty for Community mode)
TREEVULN_LICENSE_KEY=
